# Optional LLM advice. Core and the default judge mode need no keys.
# Enable in PowerShell: $env:FP_LLM_PROVIDER = 'openai'.
# Set 'off' for offline evaluation and reproducible submission exports.
# FP_LLM_PROVIDER is read from the process, not this file.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Legacy OPEN_AI_API_KEY is also accepted; OPENAI_API_KEY takes precedence.
